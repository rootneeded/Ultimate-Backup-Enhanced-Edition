<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>UltimateBackupReplacement</AssemblyName>
    <RootNamespace>UltimateBackupReplacement</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ВАЖНО: эти DLL не входят в проект и не скачиваются автоматически.
      RAGEPluginHook.exe - из папки установки RPH (обычно корень GTA V).
      RAGENativeUI.dll - используется для всего UI мода (меню Partners/Code2/Code3),
      возьми последнюю версию с https://github.com/alexguirre/RAGENativeUI/releases
      (или актуального форка, если оригинальный репозиторий не поддерживается).
      Положи обе в lib/ - смотри README.md для полных шагов сборки.
    -->
    <Reference Include="RAGEPluginHook">
      <HintPath>lib\RAGEPluginHook.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RAGENativeUI">
      <HintPath>lib\RAGENativeUI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="lib\**" />
  </ItemGroup>

</Project>
