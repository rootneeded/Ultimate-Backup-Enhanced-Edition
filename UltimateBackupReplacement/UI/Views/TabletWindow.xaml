<Window x:Class="UltimateBackupReplacement.UI.TabletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LSPD MDT"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>

        <SolidColorBrush x:Key="BezelBrush" Color="#FF15181C"/>
        <SolidColorBrush x:Key="ScreenTopBrush" Color="#FF0C1E30"/>
        <SolidColorBrush x:Key="ScreenBottomBrush" Color="#FF081420"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF2E7FC1"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFF2B33D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE7EEF5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF7E93AA"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF122740"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FF224063"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#FF1B3A5C"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFB33A3A"/>

        <LinearGradientBrush x:Key="ScreenBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0C1E30" Offset="0"/>
            <GradientStop Color="#FF081420" Offset="1"/>
        </LinearGradientBrush>

        <!-- Кнопка навигации слева (Partners / Code 2 / Code 3) -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Foreground" Value="#FF0B1420"/>
            <Setter Property="Background" Value="{StaticResource AccentAmber}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmber}"/>
        </Style>

        <!-- Обычная командная кнопка в сетке команд -->
        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="Background" Value="#FF3A1414"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="CallButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0C1E30"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF0C1E30"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Строка юнита в списке: цветной индикатор статуса + подпись -->
        <DataTemplate x:Key="UnitItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,4">
                <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#332E7FC1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#221B3A5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Внешний "корпус" планшета - толстая тёмная рамка (бронированный кейс) -->
    <Border Background="{StaticResource BezelBrush}" CornerRadius="14" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <!-- "Экран" планшета -->
        <Border Background="{StaticResource ScreenBackground}" CornerRadius="4" BorderBrush="#FF000000" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LSPD" Foreground="{StaticResource AccentAmber}" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                        <TextBlock Text="MDT — UNIT CONTROL" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Content="✕ CLOSE (B)" Style="{StaticResource CommandButtonStyle}"
                            Height="36" Click="BtnClose_Click" VerticalAlignment="Center"/>
                </Grid>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="20,0,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nav rail -->
                    <StackPanel Grid.Column="0" Margin="0,10,14,0">
                        <Button x:Name="BtnTabPartners" Content="PARTNERS" Style="{StaticResource NavButtonActiveStyle}" Click="BtnTabPartners_Click"/>
                        <Button x:Name="BtnTabCode2" Content="CODE 2" Style="{StaticResource NavButtonStyle}" Click="BtnTabCode2_Click"/>
                        <Button x:Name="BtnTabCode3" Content="CODE 3" Style="{StaticResource NavButtonStyle}" Click="BtnTabCode3_Click"/>
                    </StackPanel>

                    <!-- ===================== PARTNERS TAB ===================== -->
                    <Grid x:Name="PartnersPanel" Grid.Column="1" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: создание партнёра сверху, список юнитов снизу -->
                        <Grid Grid.Column="0" Margin="0,10,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- New Partner -->
                            <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                                <StackPanel Margin="10">
                                    <TextBlock Text="NEW PARTNER" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>

                                    <TextBlock Text="Handgun" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,2"/>
                                    <ComboBox x:Name="CmbHandgun" SelectedIndex="0"/>

                                    <TextBlock Text="Rifle" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,2"/>
                                    <ComboBox x:Name="CmbRifle" SelectedIndex="0"/>

                                    <TextBlock Text="Vehicle" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,2"/>
                                    <ComboBox x:Name="CmbCar" SelectedIndex="0"/>

                                    <CheckBox x:Name="ChkCopyOutfit" Content="Copy player outfit" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>

                                    <Button x:Name="BtnCreatePartner" Content="CREATE PARTNER" Style="{StaticResource CommandButtonStyle}"
                                            Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="BtnCreatePartner_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Units list -->
                            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <DockPanel Margin="10">
                                    <TextBlock DockPanel.Dock="Top" Text="UNITS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                                    <Button DockPanel.Dock="Bottom" x:Name="BtnSelectAllPartners" Content="SELECT ALL" Style="{StaticResource CommandButtonStyle}"
                                            Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="BtnSelectAllPartners_Click"/>
                                    <ListBox x:Name="PartnersUnitsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                             ItemTemplate="{StaticResource UnitItemTemplate}"
                                             SelectionMode="Multiple" SelectionChanged="PartnersUnitsList_SelectionChanged"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Commands -->
                        <ScrollViewer Grid.Column="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="MOVEMENT" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <Button Content="GO TO" Style="{StaticResource CommandButtonStyle}" Click="BtnGoTo_Click" Tag="Partners"/>
                                    <Button Content="FOLLOW ME" Style="{StaticResource CommandButtonStyle}" Click="BtnFollowMe_Click" Tag="Partners"/>
                                    <Button Content="PATROL" Style="{StaticResource CommandButtonStyle}" Click="BtnPatrol_Click" Tag="Partners"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,8" VerticalAlignment="Center">
                                        <TextBlock Text="Radius:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Slider x:Name="PatrolRadiusSlider" Width="100" Minimum="20" Maximum="300" Value="100"
                                                TickFrequency="20" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="PatrolRadiusSlider_ValueChanged"/>
                                        <TextBlock x:Name="PatrolRadiusLabel" Text="100m" Foreground="{StaticResource TextPrimary}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" Width="34"/>
                                    </StackPanel>
                                    <Button Content="CONVOY" Style="{StaticResource CommandButtonStyle}" Click="BtnConvoy_Click" Tag="Partners"/>
                                    <Button Content="GET IN VEHICLE" Style="{StaticResource CommandButtonStyle}" Click="BtnGetInVehicle_Click" Tag="Partners"/>
                                    <Button Content="EXIT VEHICLE" Style="{StaticResource CommandButtonStyle}" Click="BtnExitVehicle_Click" Tag="Partners"/>
                                    <Button Content="REGROUP" Style="{StaticResource CommandButtonStyle}" Click="BtnRegroup_Click" Tag="Partners"/>
                                    <Button Content="HOLD POSITION" Style="{StaticResource CommandButtonStyle}" Click="BtnHoldPosition_Click" Tag="Partners"/>
                                    <Button Content="TAKE COVER" Style="{StaticResource CommandButtonStyle}" Click="BtnTakeCover_Click" Tag="Partners"/>
                                    <Button Content="COVER ME" Style="{StaticResource CommandButtonStyle}" Click="BtnCoverMe_Click" Tag="Partners"/>
                                </WrapPanel>

                                <TextBlock Text="SUSPECT" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel>
                                    <Button Content="STOP PED" Style="{StaticResource CommandButtonStyle}" Click="BtnStopPed_Click"/>
                                    <Button Content="REQUEST ID" Style="{StaticResource CommandButtonStyle}" Click="BtnRequestId_Click"/>
                                    <Button Content="REQUEST DRIVER LICENSE" Style="{StaticResource CommandButtonStyle}" Click="BtnRequestLicense_Click"/>
                                    <Button Content="REQUEST REGISTRATION" Style="{StaticResource CommandButtonStyle}" Click="BtnRequestRegistration_Click"/>
                                    <Button Content="REQUEST EXIT VEHICLE" Style="{StaticResource CommandButtonStyle}" Click="BtnRequestExitVehicle_Click"/>
                                </WrapPanel>

                                <TextBlock Text="ARREST" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel>
                                    <Button Content="ARREST" Style="{StaticResource CommandButtonStyle}" Click="BtnArrest_Click"/>
                                    <Button Content="FORCE ARREST" Style="{StaticResource DangerButtonStyle}" Click="BtnForceArrest_Click"/>
                                    <Button Content="GUARD SUSPECT" Style="{StaticResource CommandButtonStyle}" Click="BtnGuardSuspect_Click"/>
                                </WrapPanel>

                                <TextBlock Text="SEARCH" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel>
                                    <Button Content="SEARCH PED" Style="{StaticResource CommandButtonStyle}" Click="BtnSearchPed_Click"/>
                                    <Button Content="SEARCH VEHICLE" Style="{StaticResource CommandButtonStyle}" Click="BtnSearchVehicle_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===================== CODE 2 TAB ===================== -->
                    <Grid x:Name="Code2Panel" Grid.Column="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,10,10,0">
                            <DockPanel Margin="10">
                                <TextBlock DockPanel.Dock="Top" Text="ACTIVE UNITS" Style="{StaticResource SectionHeaderStyle}"/>
                                <ListBox x:Name="Code2UnitsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                         ItemTemplate="{StaticResource UnitItemTemplate}"
                                         SelectionMode="Multiple" SelectionChanged="Code2UnitsList_SelectionChanged"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CALL UNIT (CODE 2)" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel x:Name="Code2CallPanel"/>

                                <TextBlock Text="COMMANDS" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel x:Name="Code2CommandsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===================== CODE 3 TAB ===================== -->
                    <Grid x:Name="Code3Panel" Grid.Column="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,10,10,0">
                            <DockPanel Margin="10">
                                <TextBlock DockPanel.Dock="Top" Text="ACTIVE UNITS" Style="{StaticResource SectionHeaderStyle}"/>
                                <ListBox x:Name="Code3UnitsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                         ItemTemplate="{StaticResource UnitItemTemplate}"
                                         SelectionMode="Multiple" SelectionChanged="Code3UnitsList_SelectionChanged"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CALL UNIT (CODE 3 — LIGHTS &amp; SIREN)" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel x:Name="Code3CallPanel"/>

                                <TextBlock Text="COMMANDS" Style="{StaticResource SectionHeaderStyle}"/>
                                <WrapPanel x:Name="Code3CommandsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Footer hint bar -->
                <TextBlock Grid.Row="2" Text="B: CLOSE   •   T: GO-TO CONFIRM / GET IN VEHICLES   •   O: FORCE ARREST   •   U: OPEN FIRE (HOLD = ALL UNITS)"
                           Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Border>
</Window>
